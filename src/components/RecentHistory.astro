---
// Recent history (LocalStorage-backed). Structure only.
// Rendering is wired in a later step.
---

<section class="history" id="recent-history" hidden>
  <div class="container">
    <div class="section-head">
      <h2>Recent</h2>
      <button type="button" class="btn btn-ghost btn-sm" id="clear-history">Clear</button>
    </div>
    <ul class="history-list" id="history-list">
      <!-- Recent queries render here (client-side, added in a later step). -->
    </ul>
  </div>
</section>
