---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageUrl = 'https://www.ecchips.com/privacy';
const pageDescription =
  'ECCHIPS collects no personal data and requires no account. See exactly what is stored on your device, what is not collected, and how to remove it.';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy — ECCHIPS',
  url: pageUrl,
  description: pageDescription,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'ECCHIPS', url: 'https://www.ecchips.com' }
};
---

<BaseLayout
  title="Privacy Policy — ECCHIPS"
  description={pageDescription}
  canonical="/privacy"
  jsonLd={[webPageSchema]}
>
  <section class="page">
    <div class="container">
      <h1>Privacy</h1>

      <p>
        Short version: no account, no upload, no tracking by default. SMD code
        decoding runs entirely in your browser. This page explains exactly what
        is stored on your device and what is never collected.
      </p>

      <h2>What is stored on your device</h2>
      <p>
        The tool uses your browser's local storage for two things:
      </p>
      <ul>
        <li>
          <strong>Recent lookups</strong> — the codes of your last successful
          queries (up to 10) so you can re-run them quickly. Stored under the
          key <code>ecchips_smd_history</code>. You can erase this at any time
          with the Clear button in the Recent section.
        </li>
        <li>
          <strong>Language preference</strong> — the interface language you
          selected, under the key <code>ecchips_lang</code>.
        </li>
      </ul>
      <p>
        This information stays in your browser on your device. It is never
        sent to ECCHIPS or to anyone else. Clearing your browser's site data
        also removes it permanently.
      </p>

      <h2>What is never collected</h2>
      <ul>
        <li>No account registration and no personal information</li>
        <li>No contact forms and no message submission</li>
        <li>No analytics, tracking pixels, or fingerprinting scripts</li>
        <li>No cookies set by this site</li>
        <li>No advertising identifiers</li>
      </ul>
      <p>
        Because decoding happens locally in JavaScript, the codes you enter
        are not transmitted anywhere.
      </p>

      <h2>Third parties</h2>
      <p>
        This site embeds no third-party scripts, fonts, images, or ads. It is
        delivered as static files over HTTPS through a content delivery
        network (Cloudflare). As with any website, the hosting provider may
        process standard request logs (such as IP address and requested URL)
        for security and operational purposes, under its own privacy policy.
      </p>

      <h2>Data sharing and sale</h2>
      <p>
        Nothing is collected by ECCHIPS, so nothing is shared or sold. There
        is no data to breach, because there is no server-side storage of your
        activity.
      </p>

      {/* TODO(owner): add a real contact channel here once one exists (see About page). */}

      <h2>Changes to this policy</h2>
      <p>
        If this policy changes, the updated version will be published on this
        page with a new "last updated" date.
      </p>

      <p class="page-updated">Last updated: August 26, 2026</p>
    </div>
  </section>
</BaseLayout>
