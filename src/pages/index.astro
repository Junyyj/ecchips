---
import BaseLayout from '../layouts/BaseLayout.astro';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'ECCHIPS — Electronic Component Intelligence',
  url: 'https://ecchips.com/',
  description: 'Practical tools for electronics engineers.',
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'ECCHIPS', url: 'https://ecchips.com' }
};
---

<BaseLayout
  title="ECCHIPS — Electronic Component Intelligence"
  description="Practical tools for electronics engineers."
  canonical="/"
  jsonLd={[webPageSchema]}
>
  <section class="hero-home">
    <div class="container">
      <h1>ECCHIPS</h1>
      <p class="hero-tagline">Electronic Component Intelligence</p>
      <p class="hero-sub">Practical tools for electronics engineers.</p>
      <p class="hero-cta">
        <a class="btn btn-primary" href="/smd-code-lookup">SMD Code Lookup →</a>
      </p>
    </div>
  </section>

  <section class="tools" aria-labelledby="tools-title">
    <div class="container">
      <h2 id="tools-title">Tools</h2>

      <div class="tools-group">
        <h3>Available</h3>
        <ul class="tool-list">
          <li><a href="/smd-code-lookup">SMD Code Lookup</a></li>
        </ul>
      </div>

      <div class="tools-group">
        <h3>Coming Soon</h3>
        <ul class="tool-list tool-list-muted">
          <li>Voltage Divider Calculator</li>
          <li>IC Package Lookup</li>
          <li>PCB Trace Width Calculator</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="about-teaser">
    <div class="container">
      <p>Building practical tools for electronics engineers.</p>
    </div>
  </section>
</BaseLayout>
