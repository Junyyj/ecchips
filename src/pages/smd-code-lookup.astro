---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHero from '../components/ToolHero.astro';
import ResultPanel from '../components/ResultPanel.astro';
import RecentHistory from '../components/RecentHistory.astro';
import EngineeringGuide from '../components/EngineeringGuide.astro';
import CodeExplainer from '../components/CodeExplainer.astro';
import FAQSection from '../components/FAQSection.astro';

const pageUrl = 'https://www.ecchips.com/smd-code-lookup/';
const pageDescription =
  'Decode common 3-digit, 4-digit and EIA-96 SMD markings. Get resistor and ceramic capacitor interpretations instantly with ECCHIPS.';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'SMD Code Lookup – Identify & Decode SMD Markings',
  url: pageUrl,
  description: pageDescription,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'ECCHIPS', url: 'https://www.ecchips.com/' }
};

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ECCHIPS SMD Code Lookup',
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  description: pageDescription,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    '3-digit SMD code decoding',
    '4-digit precision resistor decoding',
    'EIA-96 code decoding',
    'Resistor and ceramic capacitor interpretation'
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does 103 mean on an SMD component?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '103 is a three-digit code: the first two digits (10) are the significant value and the third digit (3) is the multiplier (×10³). It reads as 10 kΩ for a resistor, or 10 nF (10,000 pF) for a ceramic capacitor.'
      }
    },
    {
      '@type': 'Question',
      name: 'Is 103 a resistor or capacitor?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The marking alone cannot tell you. 103 can be a 10 kΩ resistor or a 10 nF ceramic capacitor. Check the physical part, its location in the circuit, and measure it to confirm.'
      }
    },
    {
      '@type': 'Question',
      name: 'What does 1002 mean on a resistor?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '1002 is a four-digit precision resistor code: the first three digits (100) are the significant value and the fourth digit (2) is the multiplier (×10²). It means 10,000 Ω, or 10 kΩ.'
      }
    },
    {
      '@type': 'Question',
      name: 'What is an EIA-96 code?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'EIA-96 is a commonly used marking convention for 1% tolerance resistors. It uses two digits plus one letter: the digits index a standard value table and the letter sets the multiplier. For example, 01C means 100 × 100 = 10 kΩ.'
      }
    },
    {
      '@type': 'Question',
      name: 'Can an SMD marking identify a component by itself?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. The same marking can have different meanings depending on the component type — 103 is valid for both a resistor and a capacitor. Always confirm using appearance, package, circuit position, and measurement.'
      }
    }
  ]
};
---

<BaseLayout
  title="SMD Code Lookup – Identify & Decode SMD Markings | ECCHIPS"
  description={pageDescription}
  canonical="/smd-code-lookup/"
  ogType="website"
  jsonLd={[webPageSchema, softwareAppSchema, faqSchema]}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">SMD Code Lookup</li>
      </ol>
    </div>
  </nav>

  <ToolHero />
  <ResultPanel />
  <RecentHistory />
  <EngineeringGuide />
  <CodeExplainer />
  <FAQSection />
</BaseLayout>
